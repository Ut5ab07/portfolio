# HTTP caching for Netlify and Cloudflare Pages (copied to the site root by the build; other hosts ignore it).
# Build output in /assets/ is fingerprinted (the file name changes when the content does): cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stack's models, textures and environment map keep stable names: cache for a day, then revalidate in the background.
/stack-assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The pages themselves always revalidate, so a new deploy is picked up at once.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
