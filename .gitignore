# ---------------------------------------------------------------------------------------------------------------
# Portfolio (Vite 8 + React 19 + three.js, npm). Everything the site needs is tracked: src/, public/ (including the
# glTF models, .bin geometry, textures and HDRI in public/stack-assets/), index.html, home.html, the config files,
# package.json and package-lock.json. Build output is regenerated by `npm run build`.
# ---------------------------------------------------------------------------------------------------------------

# Dependencies
node_modules/
.npm/
.pnpm-store/
.yarn/
.pnp.*

# Build output (dist/ also holds the generated *.gz copies of the Stack assets)
dist/
dist-ssr/
build/
out/
*.local

# Caches (Vite keeps its pre-bundle cache in node_modules/.vite; a custom cacheDir is listed too)
.vite/
.vite-cache/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vercel/
.netlify/
.wrangler/

# Environment variables and secrets (the site needs none today; .env.example stays shareable)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets.*
credentials*.json

# Logs and temporary files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*~

# Testing, coverage and profiling output
coverage/
.nyc_output/
playwright-report/
test-results/
*.cpuprofile
*.heapsnapshot
*.heapprofile
Trace-*.json

# Local archives and exports (deliverable zips are built outside the repository)
*.zip

# Operating system
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Editors (keep shared VS Code settings and recommended extensions if they are added later)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
